    {
      "key": "gateway",
      "value": "http://localhost:8888"
    },
    {
      "key": "eureka",
      "value": "http://localhost:8761"
    },
    {
      "key": "customerDirect",
      "value": "http://localhost:8001"
    },
    {
      "key": "accountDirect",
      "value": "http://localhost:8100"
    },
    {
      "key": "newMobile",
      "value": "98765432"
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
