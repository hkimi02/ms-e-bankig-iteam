{
  "info": {
    "name": "ms-e-banking-ccv3x",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "E-banking microservices behind Spring Cloud Gateway (8888) + Eureka (8761). Run folders top to bottom: 'GET all accounts' stores {{accountId}}."
  },
